# 클로즈베타 사전등록 폼 수신 엔드포인트 (Apps Script 웹앱 URL)
# 형식: https://script.google.com/macros/s/AKfy.../exec
# 이 값이 있으면 폼이 실제 제출 모드로 동작하고, 없으면 데모(검증만) 모드로 동작한다.
# 배포 방법은 server/beta-form/README.md 참고.
#
# 실제 값은 .env.local 에 넣어 커밋하지 않는다.
VITE_BETA_ENDPOINT=

# BFF(앱 서버) base URL. 가입 페이지(/signup)가 이 주소로 계정 생성을 요청한다.
# 로컬: Standin-app-server 를 띄우면 http://localhost:8080
# 이 값이 없으면 가입 폼은 데모 모드가 되어 제출 성공을 가장하지 않는다.
# 운영: https://api.standinpose.com
VITE_API_BASE_URL=https://api.standinpose.com
