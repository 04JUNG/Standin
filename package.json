{
  "name": "standin-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:feedback && npm run check:measurement && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-seo.mjs && node scripts/check-legal.mjs",
    "check:measurement": "node --experimental-strip-types --test scripts/measurement.test.mjs scripts/acquisition.test.mjs",
    "check:countdown": "node --experimental-strip-types scripts/check-countdown.mjs",
    "sync:legal": "node scripts/sync-legal.mjs",
    "check:legal": "node scripts/check-legal.mjs",
    "check:legal-release": "node scripts/check-legal.mjs --release",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "sync:feedback": "node scripts/sync-feedback-schema.mjs",
    "check:feedback": "node scripts/sync-feedback-schema.mjs --check && node --test scripts/open-beta.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10"
  }
}
